{
  "compilerOptions": {
    "target": "es6",
    "lib": [
      "es2017",
      "dom",
      "scripthost"
    ],
    "module": "commonjs",
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "downlevelIteration": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
